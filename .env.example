# Confluence connection. Copy file này thành .env rồi điền secret ở máy bạn — .env đã bị chặn khỏi git.

# bearer (mặc định, dùng CONFLUENCE_TOKEN) hoặc basic (dùng USERNAME/PASSWORD).
CONFLUENCE_AUTH_MODE=bearer

# Personal Access Token của tài khoản Confluence của bạn — không dùng chung token.
CONFLUENCE_TOKEN=
# CONFLUENCE_USERNAME=your_username
# CONFLUENCE_PASSWORD=your_password

# Base URL của Confluence nội bộ, có dấu / ở cuối. Bắt buộc — không còn giá trị mặc định trong code.
CONFLUENCE_URL=http://10.16.16.242:8090/
# Tuỳ chọn: URL dự phòng nếu CONFLUENCE_URL không truy cập được (VPN/mạng khác).
CONFLUENCE_FALLBACK_URL=https://cic.ntda.io.vn
# Tuỳ chọn: Space key mặc định khi confluence_writer.py không truyền --space.
CONFLUENCE_SPACE=CIC
# Nhãn môi trường — thông tin, chưa script nào đọc để đổi hành vi.
CONFLUENCE_ENV=production

# CONFLUENCE_URL dùng http:// (không phải https://) thì bắt buộc phải bật cờ này,
# coi như xác nhận đây là mạng nội bộ tin cậy — thiếu thì script từ chối chạy.
CONFLUENCE_ALLOW_INSECURE_HTTP=true
# Kiểm chứng chứng chỉ TLS khi gọi https — đặt false nếu server dùng self-signed cert.
CONFLUENCE_VERIFY_TLS=true

# Timeout theo giây cho từng lần gọi API.
CONFLUENCE_CONNECT_TIMEOUT=5
CONFLUENCE_READ_TIMEOUT=30
# Số lần thử lại khi gặp lỗi mạng/HTTP 429/5xx, cách nhau theo backoff luỹ thừa
# (backoff_factor * 2^lần thử). POST (tạo trang, upload ảnh) không tự retry —
# tránh tạo trùng nếu request trước đã thành công nhưng phản hồi bị mất.
CONFLUENCE_MAX_RETRIES=3
CONFLUENCE_BACKOFF_FACTOR=1
